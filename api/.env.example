# Configuração da API GeevheitNeural (Produção e Staging)
PORT=8085
LOG_LEVEL=info

# Conexão PostgreSQL (Supabase Nuvem - Pooler porta 6543 ou 5432 com sslmode=require)
DATABASE_URL=postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Protocolo simples para compatibilidade com poolers pgbouncer se necessário
DB_SIMPLE_PROTOCOL=false

# UUID do Dono (obtido após criar o primeiro usuário no Supabase Auth)
OWNER_USER_ID=00000000-0000-0000-0000-000000000001

# Supabase Auth e JWT
SUPABASE_URL=https://[SEU-PROJECT-REF].supabase.co
SUPABASE_JWT_SECRET=troque-pelo-jwt-secret-do-painel-supabase-com-32-chars-ou-mais

# CORS permitindo o domínio de produção do frontend
CORS_ALLOWED_ORIGINS=https://geevheit.vercel.app,https://geevheit.pages.dev,http://localhost:3000

# URL pública base da aplicação frontend (para geração de links de proposta e escopo)
BASE_URL=https://geevheit.vercel.app

# Provedor de IA da Fábrica Autônoma (Fase 16 - Free Tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AGENT_RUNNER_TYPE=gemini

# Notificações Operacionais Multicanal (Fase 15)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=


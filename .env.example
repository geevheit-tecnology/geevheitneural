# GeevheitNeural — variáveis de ambiente (exemplo, SEM valores reais)
# Copie para .env e preencha. Nunca commite o .env.

# ---------- Banco (local: Supabase CLI) ----------
# Usado pelo goose (migrations) — usuário administrador.
MIGRATIONS_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres?sslmode=disable

# Usado pela API — role geev_api (sem BYPASSRLS). A senha é definida por `make db-api-role`.
GEEV_API_DB_PASSWORD=troque-esta-senha-local
DATABASE_URL=postgresql://geev_api:troque-esta-senha-local@127.0.0.1:54332/postgres?sslmode=disable
# true quando conectar pelo pooler do Supabase em modo transação (porta 6543).
DB_SIMPLE_PROTOCOL=false

# ---------- Auth ----------
# UUID do único usuário dono (auth.users.id). Criado por `make owner-create`.
OWNER_USER_ID=
# URL do Supabase (local: http://127.0.0.1:54331). A API busca o JWKS em $SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_URL=http://127.0.0.1:54331
# Opcional: segredo HS256 (projetos que ainda assinam JWT com segredo compartilhado). Vazio = usa JWKS.
SUPABASE_JWT_SECRET=

# ---------- API ----------
PORT=8085
LOG_LEVEL=info
# Origens permitidas (CSV). Ex.: http://localhost:3000,https://central.exemplo.com.br
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------- Fábrica Autônoma (Fase 16 - Custo Zero) ----------
# Chave gratuita do Google AI Studio (Free Tier: 15 RPM / 1.500 req/dia).
# Deixe em branco para usar o MockAgentRunner local em testes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AGENT_RUNNER_TYPE=gemini

# ---------- Notificações Operacionais & Webhooks (Fase 15) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ---------- Web (públicas, vão para o bundle) ----------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
# Chave pública (anon/publishable) do Supabase. É pública por natureza; nunca use a service_role aqui.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8080

